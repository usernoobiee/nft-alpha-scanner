# OpenSea REST API key. Keep this server-side only.
OPENSEA_API_KEY=

# Public origin after deployment. Must match the tool endpoint origin exactly.
TOOL_ENDPOINT=https://YOUR-PROJECT.vercel.app/api

# Wallet that will register the tool on Base. Do not commit private keys.
CREATOR_ADDRESS=0x000000000000000000000000000000000000dEaD

# Used only by the SDK CLI for onchain registration.
PRIVATE_KEY=
RPC_URL=https://mainnet.base.org

# Metadata URL. Same origin as TOOL_ENDPOINT.
TOOL_METADATA_URL=https://YOUR-PROJECT.vercel.app/.well-known/ai-tool/nft-alpha-scanner.json
